<div class="search-page">
    <h1 class="sr-only">실시간 신차 장기렌트 리스 견적 검색</h1>
    <div class="container">
        <!-- Brand Selection Grid -->
        <section class="brand-selection">
            <div class="section-header">
                <h3>브랜드 선택</h3>
            </div>

            <!-- 국산차 섹션 -->
            <div class="brand-category">
                <h4 class="category-title">국산차 브랜드</h4>
                <div class="brand-grid">
                    <div class="brand-item domestic" data-brand="genesis">
                        <div class="brand-logo"><img src="/images/car_logo/제네시스_로고.webp" alt="제네시스"></div>
                        <span>제네시스</span>
                    </div>
                    <div class="brand-item domestic" data-brand="kia">
                        <div class="brand-logo"><img src="/images/car_logo/기아자동차.webp" alt="기아"></div>
                        <span>기아</span>
                    </div>
                    <div class="brand-item domestic" data-brand="renault">
                        <div class="brand-logo"><img src="/images/car_logo/르노코리아.webp" alt="르노코리아"></div>
                        <span>르노코리아</span>
                    </div>
                    <div class="brand-item domestic" data-brand="chevrolet">
                        <div class="brand-logo"><img src="/images/car_logo/쉐보레.webp" alt="쉐보레"></div>
                        <span>쉐보레</span>
                    </div>
                    <div class="brand-item domestic" data-brand="kgm">
                        <div class="brand-logo"><img src="/images/car_logo/KGM.webp" alt="KGM"></div>
                        <span>KGM</span>
                    </div>
                </div>
            </div>

            <div class="category-divider"></div>

            <!-- 수입차 섹션 -->
            <div class="brand-category">
                <h4 class="category-title">수입차 브랜드</h4>
                <div class="brand-grid">
                    <div class="brand-item imported" data-brand="benz">
                        <div class="brand-logo"><img src="/images/car_logo/벤츠.webp" alt="벤츠"></div>
                        <span>벤츠</span>
                    </div>
                    <div class="brand-item imported" data-brand="bmw">
                        <div class="brand-logo"><img src="/images/car_logo/bmw.webp" alt="BMW"></div>
                        <span>BMW</span>
                    </div>
                    <div class="brand-item imported" data-brand="audi">
                        <div class="brand-logo"><img src="/images/car_logo/아우디.webp" alt="아우디"></div>
                        <span>아우디</span>
                    </div>
                    <div class="brand-item imported" data-brand="tesla">
                        <div class="brand-logo"><img src="/images/car_logo/테슬라.webp" alt="테슬라"></div>
                        <span>테슬라</span>
                    </div>
                    <div class="brand-item imported" data-brand="porsche">
                        <div class="brand-logo"><img src="/images/car_logo/포르쉐.webp" alt="포르쉐"></div>
                        <span>포르쉐</span>
                    </div>
                    <div class="brand-item imported" data-brand="landrover">
                        <div class="brand-logo"><img src="/images/car_logo/랜드로버.webp" alt="랜드로버"></div>
                        <span>랜드로버</span>
                    </div>
                    <div class="brand-item imported" data-brand="volvo">
                        <div class="brand-logo"><img src="/images/car_logo/볼보.webp" alt="볼보"></div>
                        <span>볼보</span>
                    </div>
                    <div class="brand-item imported" data-brand="jeep">
                        <div class="brand-logo"><img src="/images/car_logo/지프.webp" alt="지프"></div>
                        <span>지프</span>
                    </div>
                    <div class="brand-item imported" data-brand="lexus">
                        <div class="brand-logo"><img src="/images/car_logo/렉서스.webp" alt="렉서스"></div>
                        <span>렉서스</span>
                    </div>
                    <div class="brand-item imported" data-brand="toyota">
                        <div class="brand-logo"><img src="/images/car_logo/도요타.webp" alt="도요타"></div>
                        <span>도요타</span>
                    </div>
                    <div class="brand-item imported" data-brand="mini">
                        <div class="brand-logo"><img src="/images/car_logo/미니.webp" alt="미니"></div>
                        <span>미니</span>
                    </div>
                    <div class="brand-item imported" data-brand="ford">
                        <div class="brand-logo"><img src="/images/car_logo/포드.webp" alt="포드"></div>
                        <span>포드</span>
                    </div>
                    <div class="brand-item imported" data-brand="lincoln">
                        <div class="brand-logo"><img src="/images/car_logo/링컨.webp" alt="링컨"></div>
                        <span>링컨</span>
                    </div>
                    <div class="brand-item imported" data-brand="maserati">
                        <div class="brand-logo"><img src="/images/car_logo/마세라티.webp" alt="마세라티"></div>
                        <span>마세라티</span>
                    </div>
                    <div class="brand-item imported" data-brand="bentley">
                        <div class="brand-logo"><img src="/images/car_logo/벤틀리.webp" alt="벤틀리"></div>
                        <span>벤틀리</span>
                    </div>
                    <div class="brand-item imported" data-brand="ferrari">
                        <div class="brand-logo"><img src="/images/car_logo/페라리.webp" alt="페라리"></div>
                        <span>페라리</span>
                    </div>
                    <div class="brand-item imported" data-brand="lamborghini">
                        <div class="brand-logo"><img src="/images/car_logo/람보르기니.webp" alt="람보르기니"></div>
                        <span>람보르기니</span>
                    </div>
                    <div class="brand-item imported" data-brand="mclaren">
                        <div class="brand-logo"><img src="/images/car_logo/맥라렌.webp" alt="맥라렌"></div>
                        <span>맥라렌</span>
                    </div>
                    <div class="brand-item imported" data-brand="astonmartin">
                        <div class="brand-logo"><img src="/images/car_logo/애스턴마틴.webp" alt="애스턴마틴"></div>
                        <span>애스턴마틴</span>
                    </div>
                    <div class="brand-item imported" data-brand="lotus">
                        <div class="brand-logo"><img src="/images/car_logo/로터스.webp" alt="로터스"></div>
                        <span>로터스</span>
                    </div>
                    <div class="brand-item imported" data-brand="rollsroyce">
                        <div class="brand-logo"><img src="/images/car_logo/롤스로이스.webp" alt="롤스로이스"></div>
                        <span>롤스로이스</span>
                    </div>
                    <div class="brand-item imported" data-brand="cadillac">
                        <div class="brand-logo"><img src="/images/car_logo/캐딜락.webp" alt="캐딜락"></div>
                        <span>캐딜락</span>
                    </div>
                    <div class="brand-item imported" data-brand="jaguar">
                        <div class="brand-logo"><img src="/images/car_logo/재규어.webp" alt="재규어"></div>
                        <span>재규어</span>
                    </div>
                    <div class="brand-item imported" data-brand="citroen">
                        <div class="brand-logo"><img src="/images/car_logo/시트로엥.webp" alt="시트로엥"></div>
                        <span>시트로엥</span>
                    </div>
                    <div class="brand-item imported" data-brand="byd">
                        <div class="brand-logo"><img src="/images/car_logo/byd.webp" alt="BYD"></div>
                        <span>BYD</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Advanced Filter Section -->
        <section class="search-filter-box">
            <div class="filter-header">
                <div class="filter-search-input">
                    <input type="text" placeholder="모델명 또는 브랜드를 입력하세요" value="<%= query.q || '' %>">
                    <button class="btn-filter-search">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-search">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.3-4.3" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="filter-options">
                <div class="filter-group">
                    <label>차종</label>
                    <select>
                        <option value="">전체 차종</option>
                        <option value="세단" <%=query.car_type==='세단' ? 'selected' : '' %>>세단</option>
                        <option value="SUV" <%=query.car_type==='SUV' ? 'selected' : '' %>>SUV</option>
                        <option value="경차/소형" <%=query.car_type==='경차/소형' ? 'selected' : '' %>>경차/소형</option>
                        <option value="MPV/RV" <%=query.car_type==='MPV/RV' ? 'selected' : '' %>>MPV/RV</option>
                        <option value="스포츠/쿠페" <%=query.car_type==='스포츠/쿠페' ? 'selected' : '' %>>스포츠/쿠페</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>가격대</label>
                    <select>
                        <option value="">전체 가격</option>
                        <option value="1" <%=query.price_range==='1' ? 'selected' : '' %>>2,000만원 이하</option>
                        <option value="2" <%=query.price_range==='2' ? 'selected' : '' %>>2,000 ~ 4,000만원</option>
                        <option value="3" <%=query.price_range==='3' ? 'selected' : '' %>>4,000 ~ 6,000만원</option>
                        <option value="4" <%=query.price_range==='4' ? 'selected' : '' %>>6,000 ~ 8,000만원</option>
                        <option value="5" <%=query.price_range==='5' ? 'selected' : '' %>>8,000만원 이상</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>연료</label>
                    <select>
                        <option value="">전체 연료</option>
                        <option value="가솔린" <%=query.fuel_type==='가솔린' ? 'selected' : '' %>>가솔린</option>
                        <option value="디젤" <%=query.fuel_type==='디젤' ? 'selected' : '' %>>디젤</option>
                        <option value="하이브리드" <%=query.fuel_type==='하이브리드' ? 'selected' : '' %>>하이브리드</option>
                        <option value="전기" <%=query.fuel_type==='전기' ? 'selected' : '' %>>전기</option>
                        <option value="LPG" <%=query.fuel_type==='LPG' ? 'selected' : '' %>>LPG</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>인승</label>
                    <select>
                        <option value="">전체 인승</option>
                        <option value="2" <%=query.capacity==='2' ? 'selected' : '' %>>2인승</option>
                        <option value="5" <%=query.capacity==='5' ? 'selected' : '' %>>5인승</option>
                        <option value="7" <%=query.capacity==='7' ? 'selected' : '' %>>7인승</option>
                        <option value="9" <%=query.capacity==='9' ? 'selected' : '' %>>9인승 이상</option>
                    </select>
                </div>
                <button class="btn-filter-reset">초기화</button>
            </div>
        </section>

        <!-- Search Results -->
        <section class="search-results">
            <div class="results-info">
                <p>총 <span>
                        <%= totalCount %>
                    </span>대의 차량이 검색되었습니다.</p>
                <div class="results-sort">
                    <button class="<%= !query.sort || query.sort === 'latest' ? 'active' : '' %>"
                        data-sort="latest">최신순</button>
                    <button class="<%= query.sort === 'price_asc' ? 'active' : '' %>"
                        data-sort="price_asc">낮은가격순</button>
                    <button class="<%= query.sort === 'price_desc' ? 'active' : '' %>"
                        data-sort="price_desc">높은가격순</button>
                </div>
            </div>

            <div class="car-grid">
                <% if (cars && cars.length> 0) { %>
                    <% cars.forEach(car=> { %>
                        <%- include('partials/car_card', { car: car }) %>
                            <% }); %>
                                <% } else { %>
                                    <div class="no-results"
                                        style="grid-column: 1/-1; padding: 100px 0; text-align: center; color: #888;">
                                        <p>검색 조건에 맞는 차량이 없습니다.</p>
                                    </div>
                                    <% } %>
            </div>

            <!-- Pagination Load More -->
            <div class="load-more-container" style="text-align: center; padding: 40px 0;">
                <% if (typeof hasMore !=='undefined' && hasMore) { %>
                    <button id="btnLoadMore" class="btn-load-more"
                        style="padding: 15px 40px; font-size: 16px; border-radius: 30px; background: white; border: 1px solid #ddd; cursor: pointer; color: #333; font-weight: 600; box-shadow: 0 4px 6px rgba(0,0,0,0.05); transition: all 0.2s ease;">
                        차량 더보기 <i class="fas fa-chevron-down" style="margin-left: 5px;"></i>
                    </button>
                    <% } %>
            </div>
        </section>
    </div>
</div>

<link rel="stylesheet" href="/css/pages/search.css">
<script src="/js/pages/search.js"></script>