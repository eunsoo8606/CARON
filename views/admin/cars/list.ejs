<div class="page-header d-flex-between">
    <div>
        <h2 class="page-title">차량 관리</h2>
        <p class="page-subtitle">판매 중인 차량 리스트를 관리하고 상세 정보를 수정할 수 있습니다.</p>
    </div>
    <a href="/console/cars/new" class="btn-primary-admin">
        <i class="fas fa-plus"></i> 새 차량 등록
    </a>
</div>

<!-- Search & Filter Area -->
<div class="content-card mb-4" style="padding: 20px;">
    <form id="filterForm" method="GET" action="/console/cars" style="display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap;">
        <div class="form-group" style="flex: 0 1 180px; margin-bottom: 0;">
            <label for="category" style="display:block; margin-bottom: 8px; font-weight: 600; font-size: 14px; color: #555;">대분류</label>
            <select name="category" id="category" class="form-control" style="width: 100%; height: 40px; padding: 0 10px; border: 1px solid #ddd; border-radius: 6px; outline: none; background-color: #fff;">
                <option value="">전체 대분류</option>
                <option value="domestic" <%= (typeof query !== 'undefined' && query.category === 'domestic') ? 'selected' : '' %>>국산 (국내)</option>
                <option value="imported" <%= (typeof query !== 'undefined' && query.category === 'imported') ? 'selected' : '' %>>수입 (국외)</option>
            </select>
        </div>
        <div class="form-group" style="flex: 0 1 180px; margin-bottom: 0;">
            <label for="brand" style="display:block; margin-bottom: 8px; font-weight: 600; font-size: 14px; color: #555;">브랜드</label>
            <select name="brand" id="brand" class="form-control" style="width: 100%; height: 40px; padding: 0 10px; border: 1px solid #ddd; border-radius: 6px; outline: none; background-color: #fff;">
                <option value="">전체 브랜드</option>
            </select>
        </div>
        <div class="form-group" style="flex: 0 1 180px; margin-bottom: 0;">
            <label for="tag" style="display:block; margin-bottom: 8px; font-weight: 600; font-size: 14px; color: #555;">마케팅 태그</label>
            <select name="tag" id="tag" class="form-control" style="width: 100%; height: 40px; padding: 0 10px; border: 1px solid #ddd; border-radius: 6px; outline: none; background-color: #fff;">
                <option value="">전체 태그</option>
                <option value="fast_ship" <%= (typeof query !== 'undefined' && query.tag === 'fast_ship') ? 'selected' : '' %>>빠른출고</option>
                <option value="hot" <%= (typeof query !== 'undefined' && query.tag === 'hot') ? 'selected' : '' %>>HOT</option>
                <option value="top10" <%= (typeof query !== 'undefined' && query.tag === 'top10') ? 'selected' : '' %>>TOP 10</option>
                <option value="inquiry_only" <%= (typeof query !== 'undefined' && query.tag === 'inquiry_only') ? 'selected' : '' %>>상담문의 전용</option>
                <option value="hidden" <%= (typeof query !== 'undefined' && query.tag === 'hidden') ? 'selected' : '' %>>미노출 차량</option>
            </select>
        </div>
        <div class="form-group" style="flex: 1 1 250px; min-width: 150px; margin-bottom: 0;">
            <label for="q" style="display:block; margin-bottom: 8px; font-weight: 600; font-size: 14px; color: #555;">차량명 검색</label>
            <input type="text" name="q" id="q" class="form-control" placeholder="모델명, 브랜드 또는 태그를 입력하세요" value="<%= (typeof query !== 'undefined' && query.q) ? query.q : '' %>" style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #ddd; border-radius: 6px; outline: none; box-sizing: border-box; background-color: #fff;">
        </div>
        <div style="display: flex; gap: 10px;">
            <button type="submit" class="btn-primary-admin" style="height: 40px; padding: 0 20px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; border: none; font-weight: 600; border-radius: 6px; color: #fff; background-color: var(--admin-primary) !important;">
                <i class="fas fa-search"></i> 검색
            </button>
            <a href="/console/cars" style="height: 40px; padding: 0 20px; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; background: #e0e0e0; color: #333; border-radius: 6px; font-weight: 600; font-size: 14px; border: 1px solid #ccc; box-sizing: border-box;">
                초기화
            </a>
        </div>
    </form>
</div>

<div class="content-card mb-4">
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th width="60">ID</th>
                    <th width="120">이미지</th>
                    <th width="120">브랜드</th>
                    <th>모델명</th>
                    <th width="120">출고가</th>
                    <th width="120">월 렌트료</th>
                    <th width="80">할인율</th>
                    <th width="100">상태</th>
                    <th width="130">등록일</th>
                    <th width="130">관리</th>
                </tr>
            </thead>
            <tbody id="carTableBody">
                <%- include('_car_rows', { cars: cars }) %>
            </tbody>
        </table>
    </div>
</div>

<style>
    .empty-row {
        padding: 100px 0 !important;
        color: #bbb;
        font-weight: 500;
        text-align: center;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 국산/수입 브랜드 목록 정의 (DB 유니크 데이터 기준 정렬)
    const domesticBrands = ['현대', '기아', '르노코리아', 'KGM', '쉐보레', '제네시스'];
    const importedBrands = ['벤츠', 'BMW', '아우디', '폭스바겐', '푸조', '테슬라', '토요타', '미니', '볼보', '렉서스', 'Jeep', '폴스타', '캐딜락'];
    
    const categorySelect = document.getElementById('category');
    const brandSelect = document.getElementById('brand');
    const selectedBrand = '<%= (typeof query !== "undefined" && query.brand) ? query.brand : "" %>';

    function updateBrandOptions() {
        const category = categorySelect.value;
        let brands = [];
        
        if (category === 'domestic') {
            brands = domesticBrands;
        } else if (category === 'imported') {
            brands = importedBrands;
        } else {
            brands = [...domesticBrands, ...importedBrands];
        }

        // 기존 브랜드 목록 비우기
        brandSelect.innerHTML = '<option value="">전체 브랜드</option>';
        
        // 가나다순 정렬 후 옵션 삽입
        brands.sort().forEach(brand => {
            const option = document.createElement('option');
            option.value = brand;
            option.textContent = brand;
            if (brand === selectedBrand) {
                option.selected = true;
            }
            brandSelect.appendChild(option);
        });
    }

    categorySelect.addEventListener('change', updateBrandOptions);
    updateBrandOptions(); // 초기 페이지 로드 시 바인딩

    // 비동기(Ajax) 검색 처리
    const filterForm = document.getElementById('filterForm');
    const carTableBody = document.getElementById('carTableBody');

    if (filterForm && carTableBody) {
        filterForm.addEventListener('submit', async function(e) {
            e.preventDefault(); // 기본 새로고침 폼 전송 차단

            const formData = new FormData(filterForm);
            const params = new URLSearchParams();

            for (const [key, value] of formData.entries()) {
                if (value) params.append(key, value);
            }
            params.append('ajax', '1');

            // 로딩 피드백 표시
            carTableBody.innerHTML = '<tr><td colspan="10" class="empty-row"><i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i> 검색 중...</td></tr>';

            try {
                const response = await fetch(`/console/cars?${params.toString()}`);
                if (!response.ok) {
                    throw new Error(`서버 응답 오류 (상태코드: ${response.status})`);
                }
                const data = await response.json();

                if (data.success) {
                    carTableBody.innerHTML = data.html;
                    
                    // 주소창 URL 업데이트 (새로고침 없이 상태 유지)
                    params.delete('ajax');
                    const newUrl = `/console/cars?${params.toString()}`;
                    window.history.pushState({ path: newUrl }, '', newUrl);
                } else {
                    carTableBody.innerHTML = '<tr><td colspan="10" class="empty-row" style="color: #ff4d4d; font-weight: 600;">데이터를 불러오는 데 실패했습니다.</td></tr>';
                }
            } catch (error) {
                console.error('Ajax Search Error:', error);
                carTableBody.innerHTML = `<tr><td colspan="10" class="empty-row" style="color: #ff4d4d; font-weight: 600;">서버 통신 오류가 발생했습니다. (${error.message})</td></tr>`;
            }
        });
    }
});
</script>