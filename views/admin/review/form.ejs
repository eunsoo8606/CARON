<div class="page-header">
    <h2 class="page-title"><%= review ? '리뷰 수정' : '새 리뷰 등록' %></h2>
    <p class="page-subtitle">메인 페이지 리뷰 섹션에 노출될 고객 생생 후기를 작성하고 차량 이미지를 설정합니다.</p>
</div>

<form action="/console/reviews/save" method="POST" enctype="multipart/form-data" class="admin-form">
    <% if (review) { %>
        <input type="hidden" name="id" value="<%= review.id %>">
    <% } %>

    <div class="form-grid">
        <div class="form-column">
            <div class="content-card mb-4">
                <h3 class="card-title"><i class="fas fa-info-circle"></i> 리뷰 정보</h3>
                
                <div class="form-group">
                    <label>차종명 <span class="required">*</span></label>
                    <input type="text" name="car_name" class="form-control" value="<%= review ? review.car_name : '' %>" placeholder="예: 제네시스 G80" required>
                </div>

                <div class="form-group">
                    <label>작성자명 <span class="required">*</span></label>
                    <input type="text" name="author_name" class="form-control" value="<%= review ? review.author_name : '' %>" placeholder="예: 김*수 고객님" required>
                </div>

                <div class="form-row">
                    <div class="form-group flex-1">
                        <label>지역</label>
                        <input type="text" name="author_region" class="form-control" value="<%= review ? review.author_region : '' %>" placeholder="예: 서울 강남">
                    </div>
                    <div class="form-group flex-1">
                        <label>상세 정보 (모델 및 등급)</label>
                        <input type="text" name="author_detail" class="form-control" value="<%= review ? review.author_detail : '' %>" placeholder="예: 제네시스 G80 하이브리드">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group flex-1">
                        <label>별점 <span class="required">*</span></label>
                        <select name="rating" class="form-control" required>
                            <option value="5" <%= (review && review.rating === 5) || !review ? 'selected' : '' %>>5점 (★★★★★)</option>
                            <option value="4" <%= review && review.rating === 4 ? 'selected' : '' %>>4점 (★★★★☆)</option>
                            <option value="3" <%= review && review.rating === 3 ? 'selected' : '' %>>3점 (★★★☆☆)</option>
                            <option value="2" <%= review && review.rating === 2 ? 'selected' : '' %>>2점 (★★☆☆☆)</option>
                            <option value="1" <%= review && review.rating === 1 ? 'selected' : '' %>>1점 (★☆☆☆☆)</option>
                        </select>
                    </div>
                    <div class="form-group flex-1">
                        <label>노출 순서</label>
                        <input type="number" name="order_index" class="form-control" value="<%= review ? review.order_index : '0' %>">
                        <p class="form-help">낮은 번호가 먼저 노출됩니다.</p>
                    </div>
                </div>

                <div class="form-group">
                    <label>리뷰 본문 <span class="required">*</span></label>
                    <textarea name="review_text" class="form-control" rows="6" placeholder="고객님의 솔직한 후기 내용을 입력해주세요." style="resize: vertical;" required><%= review ? review.review_text : '' %></textarea>
                </div>
            </div>
        </div>

        <div class="form-column">
            <div class="content-card">
                <h3 class="card-title"><i class="fas fa-image"></i> 차량 이미지 <span class="required">*</span></h3>
                <label for="imageInput" class="image-upload-box" id="imagePreviewBox" style="aspect-ratio: 4/3; cursor: pointer; display: flex; align-items: center; justify-content: center; border: 2px dashed #ccc; border-radius: 8px; overflow: hidden; position: relative;">
                    <% if (review && review.car_image_id) { %>
                        <img src="/api/image/<%= review.car_image_id %>" class="preview-img" style="width: 100%; height: 100%; object-fit: cover;">
                    <% } else { %>
                        <div class="upload-placeholder" style="text-align: center; color: #888;">
                            <i class="fas fa-cloud-upload-alt" style="font-size: 32px; margin-bottom: 8px;"></i>
                            <p>클릭하여 차량 이미지 업로드</p>
                        </div>
                    <% } %>
                </label>
                <input type="file" name="car_image" id="imageInput" accept="image/*" style="display: none;" <%= review ? '' : 'required' %>>
                <p class="form-help mb-4">권장 사이즈: 600x450px (4:3 비율의 깨끗한 차량 인도 이미지)</p>

                <div class="switch-container mt-4">
                    <div class="switch-label">
                        <strong>노출 상태</strong>
                    </div>
                    <div style="display: flex; align-items: center;">
                        <label class="admin-switch">
                            <input type="checkbox" name="is_visible" value="1" <%= (review === null || review.is_visible) ? 'checked' : '' %> id="visibleToggle">
                            <span class="slider"></span>
                        </label>
                        <span class="status-text" id="statusText"><%= (review === null || review.is_visible) ? '노출 중' : '숨김' %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="button" class="btn-cancel" onclick="history.back()">취소</button>
        <button type="submit" class="btn-submit"><i class="fas fa-save"></i> 저장하기</button>
    </div>
</form>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const setupPreview = (input, previewBox) => {
        if (!input || !previewBox) return;

        input.addEventListener('change', function() {
            const file = this.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const placeholder = previewBox.querySelector('.upload-placeholder');
                if (placeholder) placeholder.style.display = 'none';

                let img = previewBox.querySelector('.preview-img');
                if (!img) {
                    img = document.createElement('img');
                    img.className = 'preview-img';
                    img.style.width = '100%';
                    img.style.height = '100%';
                    img.style.objectFit = 'cover';
                    previewBox.prepend(img);
                }
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        });
    };

    setupPreview(document.getElementById('imageInput'), document.getElementById('imagePreviewBox'));

    const visibleToggle = document.getElementById('visibleToggle');
    const statusText = document.getElementById('statusText');
    if (visibleToggle && statusText) {
        visibleToggle.addEventListener('change', function() {
            statusText.textContent = this.checked ? '노출 중' : '숨김';
        });
    }
});
</script>
