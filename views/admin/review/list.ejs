<div class="page-header d-flex-between">
    <div>
        <h2 class="page-title">리뷰 관리</h2>
        <p class="page-subtitle">메인 페이지에 노출될 고객의 실제 출고 후기(리뷰)를 관리합니다.</p>
    </div>
    <a href="/console/reviews/new" class="btn-primary-admin">
        <i class="fas fa-plus"></i> 새 리뷰 등록
    </a>
</div>

<div class="content-card mb-4">
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th width="60">순서</th>
                    <th width="150">차량 이미지</th>
                    <th>차종명</th>
                    <th>작성자</th>
                    <th>지역 및 상세정보</th>
                    <th width="100">별점</th>
                    <th width="100">상태</th>
                    <th width="130">등록일</th>
                    <th width="130">관리</th>
                </tr>
            </thead>
            <tbody>
                <% if (reviews && reviews.length > 0) { %>
                    <% reviews.forEach(review => { %>
                        <tr>
                            <td><%= review.order_index %></td>
                            <td>
                                <div class="car-thumb" style="width: 100px; height: 55px; border: 1px solid #eee; margin: 0 auto; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                    <% if (review.car_image_id) { %>
                                        <img src="/api/image/<%= review.car_image_id %>" alt="Car image" style="width: 100%; height: 100%; object-fit: cover;">
                                    <% } else { %>
                                        <div class="no-img" style="color: #ccc; font-size: 11px;">이미지 없음</div>
                                    <% } %>
                                </div>
                            </td>
                            <td class="text-left">
                                <strong><%= review.car_name %></strong>
                            </td>
                            <td>
                                <%= review.author_name %>
                            </td>
                            <td class="text-left">
                                <span class="text-muted">
                                    <%= review.author_region || '-' %> · <%= review.author_detail || '-' %>
                                </span>
                            </td>
                            <td>
                                <div style="color: #ffc107;">
                                    <% for (let i = 0; i < 5; i++) { %>
                                        <%= i < review.rating ? '★' : '☆' %>
                                    <% } %>
                                </div>
                            </td>
                            <td>
                                <% if (review.is_visible) { %>
                                    <span class="status-active">노출중</span>
                                <% } else { %>
                                    <span class="status-inactive">숨김</span>
                                <% } %>
                            </td>
                            <td>
                                <%= review.created_at ? (review.created_at.toISOString ? review.created_at.toISOString().split('T')[0] : String(review.created_at).split(' ')[0]) : '-' %>
                            </td>
                            <td>
                                <div class="action-btns">
                                    <a href="/console/reviews/<%= review.id %>" class="btn-edit" title="수정"><i class="fas fa-edit"></i></a>
                                    <button type="button" class="btn-delete" onclick="handleReviewDelete(this, <%= review.id %>)" title="삭제"><i class="fas fa-trash-alt"></i></button>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="9" class="empty-row">등록된 리뷰가 없습니다.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
async function handleReviewDelete(btn, id) {
    if (!confirm('정말 이 리뷰를 삭제하시겠습니까?')) return;
    
    try {
        const response = await fetch(`/console/reviews/${id}/delete`, {
            method: 'POST'
        });
        
        if (response.ok) {
            alert('삭제되었습니다.');
            location.reload();
        } else {
            alert('삭제 중 오류가 발생했습니다.');
        }
    } catch (err) {
        console.error(err);
        alert('삭제 요청에 실패했습니다.');
    }
}
</script>

<style>
    .empty-row {
        padding: 100px 0 !important;
        color: #bbb;
        font-weight: 500;
        text-align: center;
    }
</style>
