<div class="container">
    <h1 class="sr-only">신차 장기렌트·리스 전문 플랫폼 CARON</h1>
    <!-- Hero Section - Contained and Rounded -->
    <section class="hero">
        <div class="swiper hero-swiper">
            <div class="swiper-wrapper">
                <% if (banners && banners.length> 0) { %>
                    <% banners.forEach(banner=> { %>
                        <div class="swiper-slide banner-slide"
                            style="--pc-bg: url('/api/image/<%= banner.image_id %>'); --mo-bg: url('/api/image/<%= banner.mobile_image_id || banner.image_id %>'); cursor: <%= banner.link_url ? 'pointer' : 'default' %>"
                            onclick="<%= banner.link_url ? `location.href='${banner.link_url}'` : '' %>"
                            aria-label="<%= banner.title %>">
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="swiper-slide" style="background-image: url('/images/banner_ex1.webp');"
                                    aria-label="메인 배너 1"></div>
                                <div class="swiper-slide" style="background-image: url('/images/banner_ex2.webp');"
                                    aria-label="메인 배너 2"></div>
                                <% } %>
            </div>
            <div class="swiper-pagination"></div>
        </div>
    </section>
</div>

<!-- Vehicle List Section -->
<section class="vehicle-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">4월 인기 <span>TOP 10</span></h2>
            <a href="/car/search" class="view-more">더보기</a>
        </div>

            <div class="swiper vehicle-swiper">
                <div class="swiper-wrapper">
                    <% if (top10Cars && top10Cars.length > 0) { %>
                        <% top10Cars.forEach(car=> { %>
                            <div class="swiper-slide vehicle-card">
                                <div class="card-img">
                                    <% if (car.thumbnail_id) { %>
                                        <img src="/api/image/<%= car.thumbnail_id %>" alt="<%= car.name_ko %> 장기렌트 리스">
                                    <% } else { %>
                                        <img src="/images/default_car.webp" alt="이미지 준비중">
                                    <% } %>
                                    <% if (car.is_hot) { %>
                                        <span class="badge">HOT</span>
                                    <% } else if (car.is_fast_ship) { %>
                                        <span class="badge">즉시출고</span>
                                    <% } %>
                                </div>
                                <div class="card-body">
                                    <h3 class="car-name">
                                        [<%= car.brand %>] <%= car.name_ko %>
                                    </h3>
                                    <p class="car-price">
                                        월 <%= car.rent_fee ? car.rent_fee.toLocaleString() : '0' %>원~
                                    </p>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="empty-msg" style="grid-column: 1/-1; padding: 50px 0; text-align: center; color: #888; width: 100%;">등록된 인기 차량이 없습니다.</p>
                    <% } %>
                </div>
            </div>
    </div>
</section>

<!-- Today's Hot Deal Section -->
<section class="hot-deal-section">
    <div class="container">
        <div class="hot-deal-header">
            <div class="title-group">
                <span class="deal-badge">LIMITED</span>
                <h2 class="section-title">오늘의 <span>핫딜</span></h2>
                <p class="section-subtitle">오늘만 이 가격! 한정 수량 특가 차량을 만나보세요.</p>
            </div>
            <div class="timer-box">
                <span class="timer-label">남은 시간</span>
                <div id="hotDealTimer" class="timer-display">23:59:59</div>
            </div>
        </div>

        <div class="hot-deal-grid">
            <% if (hotCars && hotCars.length > 0) { %>
                <% hotCars.forEach(car => { %>
                    <div class="hot-deal-card">
                        <div class="card-img">
                            <% if (car.thumbnail_id) { %>
                                <img src="/api/image/<%= car.thumbnail_id %>" alt="<%= car.name_ko %> 핫딜">
                            <% } else { %>
                                <img src="/images/default_car.webp" alt="이미지 준비중">
                            <% } %>
                        </div>
                        <div class="card-info">
                            <span class="car-brand"><%= car.brand %></span>
                            <h3 class="car-name"><%= car.name_ko %></h3>
                            <div class="price-group">
                                <span class="rent-label">월 렌트료</span>
                                <div class="price-box">
                                    <span class="price">월 <%= car.rent_fee ? car.rent_fee.toLocaleString() : '0' %>원~</span>
                                </div>
                            </div>
                            <button class="btn-deal-inquiry" onclick="location.href='/car/search?q=<%= encodeURIComponent(car.name_ko) %>'">견적 확인하기</button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-deal" style="grid-column: 1/-1; text-align: center; padding: 60px 0; background: #f9f9f9; border-radius: 12px;">
                    <p style="color: #888;">현재 진행 중인 핫딜 차량이 없습니다.</p>
                </div>
            <% } %>
        </div>
    </div>
</section>

<script>
// Today's Hot Deal Countdown Timer
function updateTimer() {
    const now = new Date();
    const midnight = new Date();
    midnight.setHours(24, 0, 0, 0); // Next midnight

    const diff = midnight - now;
    
    if (diff <= 0) {
        document.getElementById('hotDealTimer').innerText = "00:00:00";
        return;
    }

    const hours = Math.floor(diff / (1000 * 60 * 60)).toString().padStart(2, '0');
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60)).toString().padStart(2, '0');
    const seconds = Math.floor((diff % (1000 * 60)) / 1000).toString().padStart(2, '0');

    const timerEl = document.getElementById('hotDealTimer');
    if (timerEl) {
        timerEl.innerText = `${hours}:${minutes}:${seconds}`;
    }
}

setInterval(updateTimer, 1000);
updateTimer();
</script>

